---
import "../styles/global.css";
import "../styles/responsive-images.css";
const { title = "The Long Pitch", description = "Stories of climbing, people and places." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body><slot /></body>
</html>
